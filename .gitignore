# Animation skills: everything setup.sh installs or downloads (bash .claude/kit/setup.sh [--voice])
.claude/kit/node_modules/
.claude/kit/vendor/
.claude/kit/models/
.claude/kit/.venv/
__pycache__/
.work/
*.snaps/
.env
.DS_Store
.claude/skills/stick-figure/engine/template/seg/
.claude/skills/stick-figure/engine/template/stills/
.claude/skills/stick-figure/engine/template/silent.mp4

# Reels: keep the source (script, shots, sound, voice take), not what make.sh regenerates
reels/*/seg/
reels/*/stills/
reels/*/silent.mp4
reels/*/*.mp4
reels/*/audio/line_*.wav
reels/*/audio/vo_kokoro.wav
reels/*/audio/mix.wav
